_bound)]\n    outlier_pct = (len(outliers) / len(df)) * 100\n    \n    print(f\"\\n{feature}:\")\n    print(f\"   Range: [{df[feature].min():.2f}, {df[feature].max():.2f}]\")\n    print(f\"   IQR Bounds: [{lower_bound:.2f}, {upper_bound:.2f}]\")\n    print(f\"   Outliers: {len(outliers)} ({outlier_pct:.1f}%)\")\n\n# Visualize data distributions\nfig, axes = plt.subplots(3, 3, figsize=(16, 12))\naxes = axes.ravel()\n\nfeatures_to_plot = ['magnitude', 'depth', 'cdi', 'mmi', 'sig', 'nst', 'dmin', 'gap', 'latitude']\n\nfor idx, feature in enumerate(features_to_plot):\n    axes[idx].hist(df[feature], bins=30, color=COLORS_PRIMARY[idx % len(COLORS_PRIMARY)], \n                   alpha=0.7, edgecolor='black')\n    axes[idx].axvline(df[feature].mean(), color='red', linestyle='--', \n                     linewidth=2, label=f'Mean: {df[feature].mean():.2f}')\n    axes[idx].axvline(df[feature].median(), color='green', linestyle='--', \n                     linewidth=2, label=f'Median: {df[feature].median():.2f}')\n    axes[idx].set_xlabel(feature, fontsize=10, fontweight='bold')\n    axes[idx].set_ylabel('Frequency', fontsize=10, fontweight='bold')\n    axes[idx].set_title(f'Distribution: {feature}', fontsize=11, fontweight='bold')\n    axes[idx].legend(fontsize=8)\n    axes[idx].grid(alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\nprint(\"\\n✅ Data quality assessment completed!\")\nprint(\"=\"*80)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-10-31T14:01:33.820887Z","iopub.execute_input":"2025-10-31T14:01:33.821316Z","iopub.status.idle":"2025-10-31T14:01:37.029132Z","shell.execute_reply.started":"2025-10-31T14:01:33.821282Z","shell.execute_reply":"2025-10-31T14:01:37.028032Z"}},"outputs":[{"name":"stdout","text":"================================================================================\n🧪 DATA QUALITY ASSESSMENT\n================================================================================\n\n📌 MISSING VALUES ANALYSIS\n--------------------------